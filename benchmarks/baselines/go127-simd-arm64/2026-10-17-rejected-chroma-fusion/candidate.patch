+//go:build goexperiment.simd && arm64 && !purego
+
+package pixel
+
+import "unsafe"
+
+// LoopFilterMacroInternalUV8 filters a macroblock boundary and one internal
+// edge in each of two disjoint eight-lane chroma planes. Each plane starts
+// four pixels before its macroblock. Unsupported geometry or thresholds
+// return false without writing, so callers can retain separate edge calls.
+func LoopFilterMacroInternalUV8(u, v []byte, step, outer, mblimit, blimit, limit, thresh int) bool {
+	if !Enabled || mblimit < 0 || mblimit >= 255 || blimit < 0 || blimit >= 255 || limit < 0 || limit > 255 || thresh < 0 || thresh > 255 {
+		return false
+	}
+	if !((outer == 1 && step >= 8) || (step == 1 && outer >= 12)) || min(len(u), len(v)) == 0 {
+		return false
+	}
+	// Each exact 12x8 window ends at 11*step+7*outer. Prove bounds with
+	// division before multiplying, including maximum-int stride arguments.
+	avail := min(len(u), len(v)) - 1
+	if step > avail/11 {
+		return false
+	}
+	avail -= 11 * step
+	if outer > avail/7 {
+		return false
+	}
+	// Aliased planes must retain their original sequential edge/plane order.
+	up, vp := uintptr(unsafe.Pointer(unsafe.SliceData(u))), uintptr(unsafe.Pointer(unsafe.SliceData(v)))
+	if (up <= vp && vp-up < uintptr(len(u))) || (vp < up && up-vp < uintptr(len(v))) {
+		return false
+	}
+	if outer == 1 {
+		loopFilterMacroInternalUVHorizontal(u, v, step, mblimit, blimit, limit, thresh)
+	} else {
+		loopFilterMacroInternalUVVertical(u, v, outer, mblimit, blimit, limit, thresh)
+	}
+	return true
+}
