+				before := bytes.Clone(p)
+				ok := pixel.LoopFilterMacroInternalUV8(p[align:align+span], p[align+gap:align+gap+span], step, outer, 64, 33, 32, 8)
+				if gap < span {
+					if ok || !bytes.Equal(p, before) {
+						t.Fatalf("aliased planes accepted/modified vertical=%v gap=%d", vertical, gap)
+					}
+					continue
+				}
+				if !ok {
+					t.Fatal("disjoint adjacent planes declined")
+				}
+				want := bytes.Clone(before)
+				for _, at := range []int{align, align + gap} {
+					if vertical {
+						mbLoopFilterVerticalEdgeScalar(want[at:], stride, 64, 32, 8, 1)
+						loopFilterVerticalEdgeScalar(want[at+4*step:], stride, 33, 32, 8, 1)
+					} else {
+						mbLoopFilterHorizontalEdgeScalar(want[at:], stride, 64, 32, 8, 1)
+						loopFilterHorizontalEdgeScalar(want[at+4*step:], stride, 33, 32, 8, 1)
+					}
+				}
+				if !bytes.Equal(p, want) {
+					t.Fatalf("adjacent plane mismatch vertical=%v gap=%d", vertical, gap)
+				}
+			}
+		}
+	}
+}
