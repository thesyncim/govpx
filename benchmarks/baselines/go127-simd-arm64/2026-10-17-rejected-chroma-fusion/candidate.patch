+func TestMacroInternalUVOracle(t *testing.T) {
+	seed := uint32(93)
+	next := func() byte { seed = seed*1664525 + 1013904223; return byte(seed >> 24) }
+	for _, vert := range []bool{false, true} {
+		for _, extra := range []int{0, 1, 7, 31} {
+			step, outer := 8+extra, 1
+			if vert {
+				step, outer = 1, 12+extra
+			}
+			for align := range 8 {
+				for trial := range 18 {
+					u, v := make([]byte, align+11*step+7*outer+1), make([]byte, align+11*step+7*outer+1)
+					for _, p := range [][]byte{u, v} {
+						for i := range p {
+							p[i] = next()
+							if trial%3 == 0 {
+								p[i] = 120 + p[i]%9
+							}
+						}
+					}
+					for _, l := range [][4]int{{0, 0, 0, 0}, {1, 1, 1, 0}, {64, 33, 32, 8}, {254, 254, 255, 255}} {
+						gu, gv, wu, wv := bytes.Clone(u), bytes.Clone(v), bytes.Clone(u), bytes.Clone(v)
+						if !LoopFilterMacroInternalUV8(gu[align:], gv[align:], step, outer, l[0], l[1], l[2], l[3]) {
+							t.Fatal("eligible declined")
+						}
+						for _, p := range [][]byte{wu, wv} {
+							loopFilterNarrow8(p, align+4*step, step, outer, l[0], l[2], l[3], 6)
+							loopFilterNarrow8(p, align+8*step, step, outer, l[1], l[2], l[3], 4)
+						}
+						if !bytes.Equal(gu, wu) || !bytes.Equal(gv, wv) {
+							t.Fatalf("vert%v extra%d align%d trial%d limits%v", vert, extra, align, trial, l)
+						}
+					}
+				}
+			}
+		}
+	}
+}
+
+func TestMacroInternalUVDeclinesWithoutStores(t *testing.T) {
+	const maxInt = int(^uint(0) >> 1)
+	for _, shape := range [][2]int{{8, 1}, {1, 12}, {0, 1}, {1, 0}, {-1, 1}, {1, -1}, {7, 1}, {1, 11}, {maxInt, 1}, {1, maxInt}} {
+		for _, limits := range [][4]int{{-1, 33, 32, 8}, {255, 33, 32, 8}, {64, -1, 32, 8}, {64, 255, 32, 8}, {64, 33, -1, 8}, {64, 33, 256, 8}, {64, 33, 32, -1}, {64, 33, 32, 256}, {64, 33, 32, 8}} {
+			for _, sizes := range [][2]int{{0, 96}, {96, 0}, {95, 96}, {96, 95}} {
+				u, v := bytes.Repeat([]byte{127}, sizes[0]+32), bytes.Repeat([]byte{127}, sizes[1]+32)
+				bu, bv := bytes.Clone(u), bytes.Clone(v)
+				if LoopFilterMacroInternalUV8(u[16:16+sizes[0]], v[16:16+sizes[1]], shape[0], shape[1], limits[0], limits[1], limits[2], limits[3]) {
+					t.Fatalf("accepted shape=%v sizes=%v limits=%v", shape, sizes, limits)
+				}
+				if !bytes.Equal(u, bu) || !bytes.Equal(v, bv) {
+					t.Fatal("declined path changed allocation")
+				}
+			}
+		}
+	}
