+// Paired chroma fusion must preserve the independent scalar libvpx v1.16.0
+// macroblock/internal edge sequence in each plane and its exact write window.
+func TestMacroInternalUVMatchesScalarEdges(t *testing.T) {
+	if !pixel.Enabled {
+		t.Skip("native SIMD unavailable")
+	}
+	seed := uint32(0x1327)
+	next := func() byte { seed = seed*1664525 + 1013904223; return byte(seed >> 24) }
+	changed := 0
+	for _, vertical := range []bool{false, true} {
+		for _, extra := range []int{0, 1, 31} {
+			step, outer := 8+extra, 1
+			if vertical {
+				step, outer = 1, 12+extra
+			}
+			stride := max(step, outer)
+			span := 11*step + 7*outer + 1
+			for align := range 8 {
+				alignV := align ^ 3
+				for trial := range 32 {
+					u, v := make([]byte, align+span+13), make([]byte, alignV+span+13)
+					for _, p := range [][]byte{u, v} {
+						for i := range p {
+							p[i] = next()
+							if trial%2 == 0 {
+								p[i] = byte(trial*8) + p[i]%9
+							}
+						}
+					}
+					for _, limits := range [][4]byte{{0, 0, 0, 0}, {1, 1, 1, 0}, {32, 17, 9, 0}, {64, 33, 32, 8}, {128, 96, 64, 1}, {254, 254, 255, 255}} {
+						gu, gv, wu, wv := bytes.Clone(u), bytes.Clone(v), bytes.Clone(u), bytes.Clone(v)
+						mb, bl, lim, thr := limits[0], limits[1], limits[2], limits[3]
+						if !pixel.LoopFilterMacroInternalUV8(gu[align:align+span], gv[alignV:alignV+span], step, outer, int(mb), int(bl), int(lim), int(thr)) {
+							t.Fatal("eligible fusion declined")
+						}
+						for plane, p := range [][]byte{wu, wv} {
+							at := align
+							if plane == 1 {
+								at = alignV
+							}
+							if vertical {
+								mbLoopFilterVerticalEdgeScalar(p[at:], stride, mb, lim, thr, 1)
+								loopFilterVerticalEdgeScalar(p[at+4*step:], stride, bl, lim, thr, 1)
+							} else {
+								mbLoopFilterHorizontalEdgeScalar(p[at:], stride, mb, lim, thr, 1)
+								loopFilterHorizontalEdgeScalar(p[at+4*step:], stride, bl, lim, thr, 1)
+							}
+						}
+						if !bytes.Equal(gu, wu) || !bytes.Equal(gv, wv) {
+							t.Fatalf("vertical=%v pitch=%d align=%d trial=%d limits=%v", vertical, stride, align, trial, limits)
+						}
+						if !bytes.Equal(gu, u) || !bytes.Equal(gv, v) {
+							changed++
+						}
+					}
+				}
+			}
+		}
+	}
+	if changed == 0 {
+		t.Fatal("fixtures exercised no active filters")
+	}
+}
