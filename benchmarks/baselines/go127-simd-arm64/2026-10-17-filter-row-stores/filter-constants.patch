--- a/internal/pixel/goav1_loopfilter_arm64.go
+++ b/internal/pixel/goav1_loopfilter_arm64.go
@@ -19,3 +19,20 @@
 func lfTruncSigned(v archsimd.Int16x8) archsimd.Int8x16 { return v.TruncToInt8() }
 
 func lfByteNot(v archsimd.Mask8x16) archsimd.Mask8x16 { return v.Not() }
+
+var (
+ lfFilterThree=archsimd.BroadcastInt8x16(3)
+ lfFilterFour=archsimd.BroadcastInt8x16(4)
+ lfFilterBias=archsimd.BroadcastUint8x16(128)
+ lfFilterCoeff9=archsimd.BroadcastInt16x8(9)
+ lfFilterCoeff18=archsimd.BroadcastInt16x8(18)
+ lfFilterCoeff27=archsimd.BroadcastInt16x8(27)
+ lfFilterRound=archsimd.BroadcastInt16x8(63)
+)
+func lfMacroCorrectionConstants(f archsimd.Int8x16,c int16) archsimd.Int8x16 {
+ k:=lfFilterCoeff9
+ if c==18 { k=lfFilterCoeff18 } else if c==27 { k=lfFilterCoeff27 }
+ lo:=lfTruncSigned(filterShift7(f.ExtendLo8ToInt16().Mul(k).Add(lfFilterRound)))
+ hi:=lfTruncSigned(filterShift7(highBytes(f.ToBits()).BitsToInt8().ExtendLo8ToInt16().Mul(k).Add(lfFilterRound)))
+ return lfJoinSigned(lo,hi)
+}
